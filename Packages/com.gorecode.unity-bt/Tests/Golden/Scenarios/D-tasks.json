{
  "schema": "unity-bt.golden/1",
  "scenarios": [
    {
      "id": "S27-S28-latent-lifecycle",
      "title": "A latent task returns InProgress and completes on a later update with exactly one Finish",
      "statements": ["S27", "S28"],
      "requires": ["sequence", "latentTask"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["w"] },
          "w": { "type": "LatentTask" }
        }
      },
      "stimulus": ["start", "tick", "complete:w:Success", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "w.activate"],
        ["w.finish:Success"],
        ["search:seq", "seq.complete:Success"]
      ]}
    },
    {
      "id": "S29-slow-abort-blocks",
      "title": "The tree does not proceed past a task until its asynchronous abort completes",
      "statements": ["S29"],
      "requires": ["sequence", "latentTask", "slowAbort", "blackboardDecorator", "observerAbort.self", "timeAdvance"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "eq", "value": 0 }, "abort": "Self" },
          "w": { "type": "LatentTask", "abortDelay": 1 },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "advance:1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=1", "g.observe", "g.fail"],
        ["search:seq", "w.abort"],
        ["w.finish:Aborted"],
        ["seq.complete:Failure"]
      ]}
    },
    {
      "id": "S30-memory-persists-across-runs",
      "title": "Per-runner node memory persists across runs: the task's activation counter keeps counting",
      "statements": ["S30"],
      "requires": ["selector", "instantTask"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["a", "b"] },
          "a": { "type": "InstantTask", "result": "Failure", "countActivations": true },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle", "start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "a.activate", "a.count:1", "a.finish:Failure"],
        ["search:sel", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"],
        ["search:root", "sel.activate", "a.activate", "a.count:2", "a.finish:Failure"],
        ["search:sel", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S60-cross-agent-isolation",
      "title": "Two runners on one tree have independent per-runner state (cooldown) and blackboards",
      "statements": ["S60"],
      "requires": ["selector", "instantTask", "cooldown", "multiRunner"],
      "runners": 2,
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["cd", "c"] },
          "cd": { "type": "CooldownDecorator", "child": "a", "seconds": 2 },
          "a": { "type": "InstantTask", "result": "Success" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["@1:start", "@1:settle", "@1:start", "@1:settle", "@2:start", "@2:settle"],
      "expected": {
        "runner1": { "updates": [
          ["search:root", "sel.activate", "cd.pass", "a.activate", "a.finish:Success"],
          ["search:sel", "sel.complete:Success"],
          ["search:root", "sel.activate", "cd.fail", "c.activate", "c.finish:Success"],
          ["search:sel", "sel.complete:Success"]
        ]},
        "runner2": { "updates": [
          ["search:root", "sel.activate", "cd.pass", "a.activate", "a.finish:Success"],
          ["search:sel", "sel.complete:Success"]
        ]}
      }
    }
  ]
}
