{
  "schema": "unity-bt.golden/1",
  "scenarios": [
    {
      "id": "S15-two-guards-and",
      "title": "Multiple decorators on one node all pass: the branch is entered",
      "statements": ["S15"],
      "requires": ["selector", "instantTask", "blackboardDecorator"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g1", "b"] },
          "g1": { "type": "BlackboardDecorator", "child": "g2", "key": "K", "query": { "op": "eq", "value": 0 } },
          "g2": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": "IsSet" },
          "a": { "type": "InstantTask", "result": "Success" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g1.pass", "g2.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S16-guard-fail-skips-branch",
      "title": "A failing decorator at entry means the branch is not entered; the selector moves on",
      "statements": ["S16"],
      "requires": ["selector", "instantTask", "blackboardDecorator"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": { "op": "eq", "value": 0 } },
          "a": { "type": "InstantTask", "result": "Success" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 1 },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.fail", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S17-abort-none-checked-at-entry",
      "title": "AbortMode.None: the condition is checked only at branch entry",
      "statements": ["S17"],
      "requires": ["sequence", "latentTask", "instantTask", "blackboardDecorator"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": { "op": "eq", "value": 0 } },
          "a": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "complete:a:Success", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "a.activate"],
        ["bb.write:K=1"],
        ["a.finish:Success"],
        ["search:seq", "b.activate", "b.finish:Success"],
        ["search:seq", "seq.complete:Success"]
      ]}
    },
    {
      "id": "S18-self-abort",
      "title": "AbortMode.Self: the condition turning false aborts the running branch and the parent continues as if it failed",
      "statements": ["S18"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": { "op": "eq", "value": 0 }, "abort": "Self" },
          "a": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "a.activate"],
        ["bb.write:K=1", "g.observe", "g.fail"],
        ["search:seq", "a.abort", "a.finish:Aborted", "seq.complete:Failure"]
      ]}
    },
    {
      "id": "S19-lower-priority-abort",
      "title": "AbortMode.LowerPriority: the guard's result flipping to passing runs a search limited to the decorated branch, aborting lower-priority execution",
      "statements": ["S19"],
      "requires": ["selector", "latentTask", "instantTask", "blackboardDecorator", "observerAbort.lowerPriority"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g", "w"] },
          "g": { "type": "BlackboardDecorator", "child": "t1", "key": "K", "query": { "op": "eq", "value": 1 }, "abort": "LowerPriority" },
          "t1": { "type": "InstantTask", "result": "Success" },
          "w": { "type": "LatentTask" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.fail", "w.activate"],
        ["bb.write:K=1", "g.observe", "g.pass"],
        ["search:sel", "g.pass", "w.abort", "w.finish:Aborted", "t1.activate", "t1.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S19-bounded-search-discarded",
      "title": "An observer-triggered search is limited to its branch: when that branch no longer passes and the only other task lies outside the range, the search is discarded and the running task is left alone",
      "statements": ["S19"],
      "requires": ["selector", "latentTask", "instantTask", "blackboardDecorator", "observerAbort.lowerPriority"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g", "w"] },
          "g": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": "IsSet", "abort": "LowerPriority" },
          "a": { "type": "InstantTask", "result": "Success" },
          "w": { "type": "LatentTask" }
        }
      },
      "stimulus": ["start", "tick", "write:K=1", "clear:K", "tick", "tick"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.fail", "w.activate"],
        ["bb.write:K=1", "g.observe", "g.pass"],
        ["bb.clear:K", "g.observe", "g.fail"],
        ["search:sel", "g.fail", "search:discard"],
        []
      ]}
    },
    {
      "id": "S20-both-abort",
      "title": "AbortMode.Both behaves as Self and LowerPriority at once",
      "statements": ["S20"],
      "requires": ["selector", "latentTask", "blackboardDecorator", "observerAbort.both"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g", "w2"] },
          "g": { "type": "BlackboardDecorator", "child": "w1", "key": "K", "query": { "op": "eq", "value": 1 }, "abort": "Both" },
          "w1": { "type": "LatentTask" },
          "w2": { "type": "LatentTask" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "write:K=0", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.fail", "w2.activate"],
        ["bb.write:K=1", "g.observe", "g.pass"],
        ["search:sel", "g.pass", "w2.abort", "w2.finish:Aborted", "w1.activate"],
        ["bb.write:K=0", "g.observe", "g.fail"],
        ["search:sel", "w1.abort", "w1.finish:Aborted", "w2.activate"]
      ]}
    },
    {
      "id": "S21-multi-observer-priority",
      "title": "One write hitting two observers: both re-evaluate; the higher-priority request wins and the other is skipped",
      "statements": ["S21"],
      "requires": ["selector", "latentTask", "instantTask", "blackboardDecorator", "observerAbort.lowerPriority"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g1", "g2", "w"] },
          "g1": { "type": "BlackboardDecorator", "child": "t1", "key": "K", "query": { "op": "eq", "value": 1 }, "abort": "LowerPriority" },
          "t1": { "type": "InstantTask", "result": "Success" },
          "g2": { "type": "BlackboardDecorator", "child": "t2", "key": "K", "query": { "op": "eq", "value": 1 }, "abort": "LowerPriority" },
          "t2": { "type": "InstantTask", "result": "Success" },
          "w": { "type": "LatentTask" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g1.fail", "g2.fail", "w.activate"],
        ["bb.write:K=1", "g1.observe", "g1.pass", "g2.observe", "g2.pass"],
        ["search:sel", "g1.pass", "w.abort", "w.finish:Aborted", "t1.activate", "t1.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S22-cooldown-window",
      "title": "Cooldown starts when the branch is left; re-entry inside the window is blocked, after it is allowed",
      "statements": ["S22"],
      "requires": ["selector", "instantTask", "cooldown", "timeAdvance"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["cd", "c"] },
          "cd": { "type": "CooldownDecorator", "child": "a", "seconds": 2 },
          "a": { "type": "InstantTask", "result": "Success" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle", "start", "settle", "advance:2", "start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "cd.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "sel.complete:Success"],
        ["search:root", "sel.activate", "cd.fail", "c.activate", "c.finish:Success"],
        ["search:sel", "sel.complete:Success"],
        ["search:root", "sel.activate", "cd.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S23-loop-finite-failure-passthrough",
      "title": "Finite loop re-activates a failing child in the next update; after the last iteration the result passes through",
      "statements": ["S23"],
      "requires": ["selector", "instantTask", "loop"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["loop", "c"] },
          "loop": { "type": "LoopDecorator", "child": "a", "mode": "Finite", "count": 2 },
          "a": { "type": "InstantTask", "result": "Failure" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "loop.pass", "a.activate", "a.finish:Failure"],
        ["search:sel", "loop.pass", "a.activate", "a.finish:Failure"],
        ["search:sel", "c.activate", "c.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S23-loop-infinite-timeout",
      "title": "Infinite loop with a timeout stops once the timeout elapsed since the first activation",
      "statements": ["S23"],
      "requires": ["selector", "instantTask", "loop", "timeAdvance"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["loop", "c"] },
          "loop": { "type": "LoopDecorator", "child": "a", "mode": "Infinite", "timeout": 1 },
          "a": { "type": "InstantTask", "result": "Success" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "tick", "tick", "advance:1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "loop.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "loop.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "loop.pass", "a.activate", "a.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S24-time-limit-fails",
      "title": "Time limit: the running branch is stopped and fails when the limit expires",
      "statements": ["S24"],
      "requires": ["sequence", "latentTask", "timeLimit", "timeAdvance"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["tl", "b"] },
          "tl": { "type": "TimeLimitDecorator", "child": "w", "seconds": 2 },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "tick", "advance:2", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "tl.pass", "w.activate"],
        ["search:seq", "w.abort", "w.finish:Aborted", "seq.complete:Failure"]
      ]}
    },
    {
      "id": "S24-time-limit-resets-on-reentry",
      "title": "Time limit: the timer restarts from the full limit every time the branch is re-entered",
      "statements": ["S24"],
      "requires": ["sequence", "latentTask", "timeLimit", "timeAdvance"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["tl", "b"] },
          "tl": { "type": "TimeLimitDecorator", "child": "w", "seconds": 2 },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "tick", "advance:1.5", "start", "tick", "advance:0.5", "tick", "advance:1.5", "tick"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "tl.pass", "w.activate"],
        ["search:root", "tl.pass", "w.abort", "w.finish:Aborted", "w.activate"],
        [],
        ["search:seq", "w.abort", "w.finish:Aborted", "seq.complete:Failure"]
      ]}
    },
    {
      "id": "S25-force-success-converts",
      "title": "ForceSuccess converts a child's Failure to Success at completion",
      "statements": ["S25"],
      "requires": ["selector", "instantTask", "forceResult"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["fs", "c"] },
          "fs": { "type": "ForceResultDecorator", "child": "a", "result": "Success" },
          "a": { "type": "InstantTask", "result": "Failure" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "fs.pass", "a.activate", "a.finish:Failure"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S25-force-success-converts-self-abort",
      "title": "ForceSuccess also converts the Failed result a Self abort delivers to the parent; the next branch never runs",
      "statements": ["S25"],
      "requires": ["selector", "latentTask", "forceResult", "blackboardDecorator", "observerAbort.self"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["fs", "c"] },
          "fs": { "type": "ForceResultDecorator", "child": "g", "result": "Success" },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "eq", "value": 0 }, "abort": "Self" },
          "w": { "type": "LatentTask" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "fs.pass", "g.pass", "w.activate"],
        ["bb.write:K=1", "g.observe", "g.fail"],
        ["search:sel", "w.abort", "w.finish:Aborted", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S26-decorator-order",
      "title": "Multiple decorators on one node evaluate in attachment order with short-circuit",
      "statements": ["S26"],
      "requires": ["selector", "instantTask", "blackboardDecorator"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g1", "b"] },
          "g1": { "type": "BlackboardDecorator", "child": "g2", "key": "K", "query": "IsSet" },
          "g2": { "type": "BlackboardDecorator", "child": "a", "key": "J", "query": "IsSet" },
          "a": { "type": "InstantTask", "result": "Success" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g1.fail", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S54-notify-result-change",
      "title": "NotifyMode.OnResultChange: a write that flips the condition result re-evaluates the guard and fires the Self abort",
      "statements": ["S54"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "eq", "value": 5 }, "abort": "Self" },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 5 },
      "stimulus": ["start", "tick", "write:K=6", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=6", "g.observe", "g.fail"],
        ["search:seq", "w.abort", "w.finish:Aborted", "seq.complete:Failure"]
      ]}
    },
    {
      "id": "S54-notify-no-op-write",
      "title": "A write that does not change the value notifies nobody and triggers nothing",
      "statements": ["S54", "S37"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "eq", "value": 5 }, "abort": "Self" },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 5 },
      "stimulus": ["start", "tick", "write:K=5", "tick"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=5"],
        []
      ]}
    },
    {
      "id": "S54-notify-result-change-no-restart",
      "title": "NotifyMode.OnResultChange: a change that leaves the condition passing re-evaluates the guard but does not restart the executing branch",
      "statements": ["S54"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "gt", "value": 3 }, "abort": "Self" },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 5 },
      "stimulus": ["start", "tick", "write:K=6", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=6", "g.observe", "g.pass"],
        []
      ]}
    },
    {
      "id": "S54-notify-value-change-restarts",
      "title": "NotifyMode.OnValueChange: any notifying write re-requests the branch; while the condition passes and the branch executes, it restarts",
      "statements": ["S54", "S49"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self", "notify.valueChange"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "gt", "value": 3 }, "notify": "OnValueChange", "abort": "Self" },
          "w": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 5 },
      "stimulus": ["start", "tick", "write:K=6", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=6", "g.observe", "g.pass"],
        ["search:seq", "g.pass", "w.abort", "w.finish:Aborted", "w.activate"]
      ]}
    },
    {
      "id": "S54-notify-value-change-keep-running",
      "title": "With RestartPolicy.KeepRunning the restart requested by OnValueChange is discarded",
      "statements": ["S54", "S49"],
      "requires": ["sequence", "latentTask", "blackboardDecorator", "observerAbort.self", "notify.valueChange", "restartPolicy"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["g", "b"] },
          "g": { "type": "BlackboardDecorator", "child": "w", "key": "K", "query": { "op": "gt", "value": 3 }, "notify": "OnValueChange", "abort": "Self" },
          "w": { "type": "LatentTask", "restartPolicy": "KeepRunning" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 5 },
      "stimulus": ["start", "tick", "write:K=6", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "g.pass", "w.activate"],
        ["bb.write:K=6", "g.observe", "g.pass"],
        ["search:seq", "g.pass", "search:discard"]
      ]}
    }
  ]
}
