{
  "schema": "unity-bt.golden/1",
  "scenarios": [
    {
      "id": "S01-idle-no-transitions",
      "title": "Event-driven: a running latent task produces no node transitions while nothing happens",
      "statements": ["S01"],
      "requires": ["sequence", "latentTask"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["w"] },
          "w": { "type": "LatentTask" }
        }
      },
      "stimulus": ["start", "tick", "tick", "tick"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "w.activate"],
        [],
        []
      ]}
    },
    {
      "id": "S02-S03-selector-fallback",
      "title": "Selector priority order: first child fails, second succeeds",
      "statements": ["S02", "S03"],
      "requires": ["selector", "instantTask"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["a", "b"] },
          "a": { "type": "InstantTask", "result": "Failure" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "a.activate", "a.finish:Failure"],
        ["search:sel", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S07-S46-one-task-per-update",
      "title": "A search activates at most one task per update; a chain of instant tasks takes one update each",
      "statements": ["S07", "S46"],
      "requires": ["sequence", "instantTask"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["a", "b", "c"] },
          "a": { "type": "InstantTask", "result": "Success" },
          "b": { "type": "InstantTask", "result": "Success" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "a.activate", "a.finish:Success"],
        ["search:seq", "b.activate", "b.finish:Success"],
        ["search:seq", "c.activate", "c.finish:Success"],
        ["search:seq", "seq.complete:Success"]
      ]}
    },
    {
      "id": "S08-deferred-continuation",
      "title": "Every request is deferred: an instant task's result is processed by the next update, never inline",
      "statements": ["S08"],
      "requires": ["selector", "instantTask"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["a", "b"] },
          "a": { "type": "InstantTask", "result": "Failure" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "tick", "tick", "tick"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "a.activate", "a.finish:Failure"],
        ["search:sel", "b.activate", "b.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S04-S49-keep-running",
      "title": "A restart re-selecting a running task with RestartPolicy.KeepRunning discards the whole search",
      "statements": ["S04", "S49"],
      "requires": ["sequence", "latentTask", "restartPolicy"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["w1"] },
          "w1": { "type": "LatentTask", "restartPolicy": "KeepRunning" }
        }
      },
      "stimulus": ["start", "tick", "start", "tick"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "w1.activate"],
        ["search:root", "search:discard"]
      ]}
    },
    {
      "id": "S04-S49-restart-default",
      "title": "A restart re-selecting a running task with the default RestartPolicy aborts and re-executes it",
      "statements": ["S04", "S49"],
      "requires": ["sequence", "latentTask", "restartPolicy"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["w1"] },
          "w1": { "type": "LatentTask" }
        }
      },
      "stimulus": ["start", "tick", "start", "tick"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "w1.activate"],
        ["search:root", "w1.abort", "w1.finish:Aborted", "w1.activate"]
      ]}
    },
    {
      "id": "S05-loop-guard-flip",
      "title": "[V] Loop re-iteration whose guard flips false between iterations (sandbox S05)",
      "statements": ["S05"],
      "requires": ["selector", "instantTask", "loop", "blackboardDecorator", "verify:S05"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["loop", "c"] },
          "loop": { "type": "LoopDecorator", "child": "g", "mode": "Finite", "count": 2 },
          "g": { "type": "BlackboardDecorator", "child": "a", "key": "K", "query": { "op": "eq", "value": 0 } },
          "a": { "type": "InstantTask", "result": "Failure" },
          "c": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "loop.pass", "g.pass", "a.activate", "a.finish:Failure"],
        ["bb.write:K=1"],
        ["search:sel", "loop.pass", "g.fail", "c.activate", "c.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S06-sequence-latent-park",
      "title": "Sequence parks at a running latent child and continues when it succeeds",
      "statements": ["S06"],
      "requires": ["sequence", "latentTask", "instantTask", "timeAdvance"],
      "tree": {
        "root": "seq",
        "nodes": {
          "seq": { "type": "Sequence", "children": ["a", "b"] },
          "a": { "type": "LatentTask", "duration": 2 },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "stimulus": ["start", "tick", "advance:2", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "seq.activate", "a.activate"],
        ["a.finish:Success"],
        ["search:seq", "b.activate", "b.finish:Success"],
        ["search:seq", "seq.complete:Success"]
      ]}
    },
    {
      "id": "S36-observer-inside-task-update",
      "title": "[V] An observer firing inside a task's update and that task's completion land in one update; the higher-priority request wins (sandbox S08)",
      "statements": ["S36"],
      "requires": ["selector", "sequence", "instantTask", "blackboardDecorator", "observerAbort.lowerPriority", "verify:S08"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g", "seq2"] },
          "g": { "type": "BlackboardDecorator", "child": "t1", "key": "K", "query": { "op": "eq", "value": 1 }, "abort": "LowerPriority" },
          "t1": { "type": "InstantTask", "result": "Success" },
          "seq2": { "type": "Sequence", "children": ["a", "b"] },
          "a": { "type": "InstantTask", "result": "Success", "writes": { "K": 1 } },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.fail", "seq2.activate", "a.activate", "bb.write:K=1", "g.observe", "g.pass", "a.finish:Success"],
        ["search:sel", "g.pass", "t1.activate", "t1.finish:Success"],
        ["search:sel", "sel.complete:Success"]
      ]}
    },
    {
      "id": "S48-continuation-no-ancestor-recheck",
      "title": "Continuation after a latent child continues at the parent without re-evaluating ancestor decorators",
      "statements": ["S48"],
      "requires": ["selector", "sequence", "latentTask", "instantTask", "blackboardDecorator"],
      "tree": {
        "root": "sel",
        "nodes": {
          "sel": { "type": "Selector", "children": ["g"] },
          "g": { "type": "BlackboardDecorator", "child": "seq2", "key": "K", "query": { "op": "eq", "value": 0 } },
          "seq2": { "type": "Sequence", "children": ["a", "b"] },
          "a": { "type": "LatentTask" },
          "b": { "type": "InstantTask", "result": "Success" }
        }
      },
      "blackboard": { "K": 0 },
      "stimulus": ["start", "tick", "write:K=1", "complete:a:Success", "tick", "settle"],
      "expected": { "updates": [
        ["search:root", "sel.activate", "g.pass", "seq2.activate", "a.activate"],
        ["bb.write:K=1"],
        ["a.finish:Success"],
        ["search:seq2", "b.activate", "b.finish:Success"],
        ["search:seq2", "seq2.complete:Success", "sel.complete:Success"]
      ]}
    }
  ]
}
